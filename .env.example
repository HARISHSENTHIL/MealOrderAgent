# Required
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=

# Voice notes (ElevenLabs speech-to-text). Leave empty to disable voice.
ELEVENLABS_API_KEY=

# Smooth Swiggy login: your ngrok STATIC domain forwarding to localhost:8765.
# Only takes effect once Swiggy whitelists <url>/callback; until then the bot uses paste-the-link login.
# FOODORDER_PUBLIC_URL=https://your-name.ngrok-free.app

# Optional
# FOODORDER_DAILY_LIMIT=40          # messages per user per day (owner unlimited)
# FOODORDER_MODEL=claude-opus-5-5
# FOODORDER_EFFORT=medium
# FOODORDER_DB_URL=postgresql+psycopg://user:pass@localhost/foodorder
